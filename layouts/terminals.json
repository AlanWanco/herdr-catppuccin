{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    16,
    18
  ],
  "theme": "graphite",
  "font_size": 15,
  "colors": {
    "background": "#1e1e2e",
    "surface": "#181825",
    "raised": "#313244",
    "hover": "#ffffff0d",
    "border": "#313244",
    "accent": "#89b4fa",
    "foreground": "#cdd6f4",
    "terminal_foreground": "#cdd6f4",
    "muted": "#a6adc8",
    "dim": "#7f849c",
    "selection": "#585b70"
  },
  "background": "#1e1e2e",
  "padding": [
    6,
    6
  ],
  "gap": 8,
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 38
      },
      "window_drag": true,
      "content": {
        "mod": "terminals-bar"
      }
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "header": {
            "content": {
              "mod": "terminals-pane"
            },
            "height": 38
          },
          "background": "#181825",
          "border": {
            "width": 1,
            "color": "#313244"
          },
          "focus": {
            "width": 1,
            "color": "#b4befe"
          },
          "radius": 12,
          "gap": 8,
          "lone": true
        }
      }
    }
  ]
}
